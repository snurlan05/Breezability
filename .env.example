# Breezability — copy to `.env` and adjust. No real secrets here.
# (The Next.js frontend reads this file automatically. The FastAPI backend
# does not — export BREEZABILITY_SERIAL_PORT in your shell before starting
# it, e.g. `export BREEZABILITY_SERIAL_PORT=/dev/ttyUSB0`.)

# Serial port of the Arduino running scripts/Servo_temp.ino.
# Windows: COM3 / COM4 — Linux: /dev/ttyUSB0 or /dev/ttyACM0 — macOS: /dev/cu.usbserial-*
BREEZABILITY_SERIAL_PORT=COM3

# URL of the FastAPI backend, used by the Next.js dashboard.
NEXT_PUBLIC_API_URL=http://localhost:8000
